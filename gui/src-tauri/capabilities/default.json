{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal capability for the BabelCodex main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/babelcodex-service",
          "sidecar": true,
          "args": [
            "--config",
            {
              "validator": "[A-Za-z0-9_./\\\\-]+\\.toml"
            }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-stdin-write",
      "allow": [
        {
          "name": "binaries/babelcodex-service",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        {
          "name": "binaries/babelcodex-service",
          "sidecar": true
        }
      ]
    }
  ]
}