{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "e2e-capability",
  "description": "WebdriverIO E2E testing capability; only included in --features e2e builds via tauri.e2e.conf.json",
  "windows": ["main"],
  "permissions": [
    "wdio:default",
    "wdio-webdriver:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/babelcodex-service",
          "sidecar": true,
          "args": [
            "--config",
            {
              "validator": "\\.\\./config/e2e\\.toml"
            }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-stdin-write",
      "allow": [
        {
          "name": "binaries/babelcodex-service",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        {
          "name": "binaries/babelcodex-service",
          "sidecar": true
        }
      ]
    }
  ]
}
